                          },
                          "internal_formulas": {
                            "paint_color": "$if(wi(temp) >= 30, #FFFF7043, wi(temp) >= 20, #FFFFCA28, wi(temp) >= 10, #FF9CCC65, wi(temp) >= 0, #FF81D4FA, #FF5C9DFF)$"
                          }
                        }
                      ]
