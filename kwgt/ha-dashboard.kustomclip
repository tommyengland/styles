                          "internal_type": "FontIconModule",
                          "icon_set": "iconify://wi?name=Weather%20Icons",
                          "internal_toggles": {
                            "icon_icon": 10,
                            "paint_color": 10
                          },
                          "internal_formulas": {
                            "icon_icon": "$if(df(S) >= ai(sunrise)*60 - 1800 & df(S) < ai(sunrise)*60, \"sunrise\",\n  df(S) >= ai(sunset)*60 & df(S) < ai(sunset)*60 + 1800, \"sunset\",\n  if(wi(icon) = CLEAR, if(ai(isday), \"day-sunny\", \"night-clear\"),\n    wi(icon) = PCLOUDY, if(ai(isday), \"day-cloudy\", \"night-alt-cloudy\"),\n    wi(icon) = MCLOUDY, if(ai(isday), \"day-cloudy\", \"night-alt-cloudy\"),\n    wi(icon) = CLOUDY, \"cloudy\",\n    wi(icon) = RAIN, if(ai(isday), \"day-rain\", \"night-alt-rain\"),\n    wi(icon) = SHOWER, if(ai(isday), \"day-showers\", \"night-alt-showers\"),\n    wi(icon) = TSTORM, if(ai(isday), \"day-thunderstorm\", \"night-alt-thunderstorm\"),\n    wi(icon) = SNOW, if(ai(isday), \"day-snow\", \"night-alt-snow\"),\n    wi(icon) = SLEET, if(ai(isday), \"day-sleet\", \"night-alt-sleet\"),\n    wi(icon) = FOG, if(ai(isday), \"day-fog\", \"night-fog\"),\n    wi(icon) = WINDY, if(ai(isday), \"day-windy\", \"night-alt-cloudy-windy\"),\n    wi(icon) = TORNADO, \"tornado\",\n    wi(icon) = HAIL, \"hail\",\n    \"na\"))$",
                            "paint_color": "$if(df(S) >= ai(sunrise)*60 - 1800 & df(S) < ai(sunrise)*60,\n  ce(#FFFF8C00, #FFFFEB3B, (df(S) - (ai(sunrise)*60 - 1800)) / 18),\n  df(S) >= ai(sunset)*60 & df(S) < ai(sunset)*60 + 1800,\n  ce(#FFFFEB3B, #FFFF3D00, (df(S) - ai(sunset)*60) / 18),\n  #FFFFB74D)$"
                          },
                          "icon_size": 90.0
                        },
                        {
                          "internal_type": "TextModule",
                          "text_expression": "$wi(temp)$°",
                          "text_size": 52.0,
                          "internal_toggles": {
