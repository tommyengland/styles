                          "internal_type": "FontIconModule",
                          "icon_set": "iconify://wi?name=Weather%20Icons",
                          "internal_toggles": {
                            "icon_icon": 10
                          },
                          "internal_formulas": {
                            "icon_icon": "$if(wf(icon, 0, 4) = CLEAR, if(ai(isday), \"day-sunny\", \"night-clear\"),\n  wf(icon, 0, 4) = PCLOUDY, if(ai(isday), \"day-cloudy\", \"night-alt-cloudy\"),\n  wf(icon, 0, 4) = MCLOUDY, if(ai(isday), \"day-cloudy\", \"night-alt-cloudy\"),\n  wf(icon, 0, 4) = CLOUDY, \"cloudy\",\n  wf(icon, 0, 4) = RAIN, if(ai(isday), \"day-rain\", \"night-alt-rain\"),\n  wf(icon, 0, 4) = SHOWER, if(ai(isday), \"day-showers\", \"night-alt-showers\"),\n  wf(icon, 0, 4) = TSTORM, if(ai(isday), \"day-thunderstorm\", \"night-alt-thunderstorm\"),\n  wf(icon, 0, 4) = SNOW, if(ai(isday), \"day-snow\", \"night-alt-snow\"),\n  wf(icon, 0, 4) = SLEET, if(ai(isday), \"day-sleet\", \"night-alt-sleet\"),\n  wf(icon, 0, 4) = FOG, if(ai(isday), \"day-fog\", \"night-fog\"),\n  wf(icon, 0, 4) = WINDY, if(ai(isday), \"day-windy\", \"night-alt-cloudy-windy\"),\n  wf(icon, 0, 4) = TORNADO, \"tornado\",\n  wf(icon, 0, 4) = HAIL, \"hail\",\n  \"na\")$"
                          },
                          "icon_size": 34.0,
                          "paint_color": "#FFFFB74D"
                        },
                        {
                          "internal_type": "TextModule",
                          "text_expression": "$wf(temp, 0, 4)$°",
                          "text_size": 20.0,
                          "internal_toggles": {
                            "text_family": 100,
                            "paint_color": 10
                          },
                          "internal_globals": {
                            "text_family": "lead txt"
                          },
                          "internal_formulas": {
                            "paint_color": "$if(wf(temp, 0, 4) >= 30, #FFFF7043, wf(temp, 0, 4) >= 20, #FFFFCA28, wf(temp, 0, 4) >= 10, #FF9CCC65, wf(temp, 0, 4) >= 0, #FF81D4FA, #FF5C9DFF)$"
                          }
                        }
                      ],
